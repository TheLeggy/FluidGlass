{
  "compilerOptions": {
    "target": "ES2026",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2026", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "testing"]
}
